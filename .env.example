# Reference only: this application does not automatically load .env files.
# Generate secrets locally or use an authorized secret manager. Never paste them into chat.
# All external operations remain disabled by default.

# Required only for `serve`; replace with a random secret of at least 24 characters.
DEMO_API_TOKEN=

# Gupshup is the selected primary WhatsApp transport. See GUPSHUP.md.
# Verify actual account support for the separate webhook-secret HTTP header first.
ENABLE_GUPSHUP_SEND=false
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
# App UUID; used to scope media URLs.
GUPSHUP_APP_ID=
# Country-code phone digits without +.
GUPSHUP_SOURCE=
# Comma-separated authorized testers in whatsapp:+E164 format.
GUPSHUP_ALLOWED_RECIPIENTS=
# Separate random ASCII secret, at least 32 characters; NOT the outbound API key.
GUPSHUP_WEBHOOK_SECRET=
# Approved template UUID with one body parameter for out-of-session sends.
GUPSHUP_TEMPLATE_ID=
# Normally leave endpoint overrides unset. Only these current /wa endpoints are accepted.
# GUPSHUP_SEND_URL=https://api.gupshup.io/wa/api/v1/msg
# GUPSHUP_TEMPLATE_URL=https://api.gupshup.io/wa/api/v1/template/msg

# Twilio optional fallback: fill only after authorization for account/tester/cost/endpoint.
ENABLE_TWILIO_SEND=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Format: whatsapp:+15551234567 (use your actual authorized sender).
TWILIO_WHATSAPP_FROM=
# Exact approved URL, including any query: https://your-approved-host/webhooks/twilio
TWILIO_WEBHOOK_URL=
# Comma-separated authorized test recipients, each in whatsapp:+E164 format.
TWILIO_ALLOWED_RECIPIENTS=
# Approved WhatsApp HX... content template accepting reminder text in variable 1.
# Mandatory for CLI live worker/serve; must be verified in the Twilio account.
TWILIO_CONTENT_SID=

# Optional interpretation for otherwise unrecognized conversational text.
# Every flag below must be deliberately authorized; offline flows need none of them.
ENABLE_CONVERSATIONAL_LLM=false
LLM_ENABLED=false
LLM_GENERAL_API_AUTHORIZED=false
# Trusted operator-configured HTTPS API base, not the /chat/completions route.
LLM_API_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# generic or zai-glm-5.3-flash; the Z.ai profile uses low reasoning and JSON output.
LLM_REQUEST_PROFILE=generic

# Optional compatible audio transcription adapter; separate authorization required.
# See SPEECH.md. Text/LLM compatibility alone does not establish audio compatibility.
STT_ENABLED=false
STT_PROVIDER_AUTHORIZED=false
# Trusted HTTPS base whose /audio/transcriptions accepts the documented multipart contract.
STT_API_BASE_URL=
STT_MODEL=
STT_API_KEY=
# Sarvam saaras:v4 reads this key instead of STT_API_KEY. Keep STT disabled
# until the tester explicitly approves Sarvam audio sharing.
SARVAM_API_KEY=
